# Nilzora admin — local environment template.
# Copy to apps/admin/.env.local (git-ignored). Every setting here is read only by the admin's
# Next.js server and never reaches browsers: do not give any of them a NEXT_PUBLIC_ prefix.
# Clients reach Supabase only through the Nilzora API, so no Supabase URL or key belongs here.
# Settings are validated on the first request; errors name the variable, never its value.
# `next start` runs in production mode, where every value marked REQUIRED must be set.

# Origin of the Nilzora API, called from this server only.
# Defaults to http://localhost:4000 in development. REQUIRED in production, where it must
# use https unless the API runs on this machine.
NILZORA_API_URL=http://localhost:4000

# Exact public origin of the admin app (no path or trailing slash). Form posts from any
# other origin are refused. Defaults to http://localhost:3001 in development.
# REQUIRED in production, where it must use https unless it is on this machine
# (a local `next start`).
APP_ORIGIN=http://localhost:3001

# Key that signs CSRF tokens: at least 32 random characters, different from
# API_CLIENT_SECRET. Development falls back to a random key per server start (open forms
# must then be reloaded). REQUIRED in production.
# SESSION_SECRET=replace-with-at-least-32-random-characters

# The API's API_CLIENT_SECRET (at least 32 characters), so the API can rate-limit each
# browser separately behind this server. The API reads the same variable name; its older
# TRUSTED_CLIENT_SECRET name still works there when API_CLIENT_SECRET is unset.
# REQUIRED in production.
# API_CLIENT_SECRET=replace-with-the-api-client-secret

# Reverse proxies in front of this server whose X-Forwarded-For entries are trusted.
# 0 (default) ignores the header; set it only when that many proxies really exist.
# TRUST_PROXY_HOPS=0

# The public storefront's address, used only to build a link for the share action. Sharing is
# never offered for an address this server is not told about; locally it falls back to the
# storefront's own development default (http://localhost:3000). Required in production.
# STOREFRONT_URL=https://nilzora.com.bd
