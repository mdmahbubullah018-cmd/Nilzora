# Nilzora storefront — local environment template.
# Copy to apps/storefront/.env.local (git-ignored). Placeholders only: never commit real values.
#
# Every setting below is SERVER-ONLY. It is read by the Next.js server (session cookies,
# CSRF checks, calls to the API) and must never be renamed with a NEXT_PUBLIC_ prefix,
# because NEXT_PUBLIC_* values are embedded in the browser bundle.
# Clients reach Supabase only through the Nilzora API, so no Supabase URL or key belongs here.

# Nilzora API origin, called from this server only. Defaults to http://localhost:4000 in
# development; required (https unless on this machine) in production.
NILZORA_API_URL=http://localhost:4000

# Exact public origin of this storefront (no path, no trailing slash). Form posts from any
# other origin are refused. Defaults to http://localhost:3000 in development. Required in
# production, where it must use https unless it is on this machine (a local `next start`).
APP_ORIGIN=http://localhost:3000

# Key for signing CSRF tokens: at least 32 random characters, different from API_CLIENT_SECRET.
# Required in production; when blank in development a random key is used per server start.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Must equal the API's API_CLIENT_SECRET (at least 32 characters): the API reads the same
# variable name, and trusts the browser address this server names for rate limiting. The
# API's older TRUSTED_CLIENT_SECRET name still works there when API_CLIENT_SECRET is unset.
# Required in production.
API_CLIENT_SECRET=

# Number of reverse proxies in front of this server whose X-Forwarded-For entries are trusted.
# Keep 0 for local development.
TRUST_PROXY_HOPS=0

# DEVELOPMENT ONLY. Set to 1 to show three clearly labelled sample banners in the home hero
# when no admin banner is on show, to preview the carousel. Ignored by production builds.
NILZORA_DEV_SAMPLE_BANNERS=

# This site's own public address, used for canonical links, share cards and the share action.
# Left unset, it is http://localhost:3000 (the development default). Required in production.
# NEXT_PUBLIC_SITE_URL=https://nilzora.com.bd
