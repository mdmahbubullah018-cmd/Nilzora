{
  "name": "@nilzora/api",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --env-file-if-exists=.env src/server.ts",
    "dev:local": "tsx watch --clear-screen=false --env-file-if-exists=.env --env-file-if-exists=.env.local src/server.ts",
    "build": "tsdown",
    "start": "node --env-file-if-exists=.env --enable-source-maps dist/server.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "bootstrap-owner": "tsx --env-file-if-exists=.env scripts/bootstrap-owner.ts",
    "bootstrap-owner:local": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/bootstrap-owner.ts",
    "reset-two-factor": "tsx --env-file-if-exists=.env scripts/reset-two-factor.ts",
    "reset-two-factor:local": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/reset-two-factor.ts",
    "seed-image-search": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/seed-image-search-fixtures.mjs",
    "evaluate-image-search": "tsx --env-file-if-exists=.env scripts/evaluate-image-search.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@fontsource/noto-sans-bengali": "catalog:",
    "@huggingface/transformers": "3.8.1",
    "@node-rs/argon2": "catalog:",
    "@nilzora/contracts": "workspace:*",
    "@nilzora/validation": "workspace:*",
    "@supabase/supabase-js": "catalog:",
    "busboy": "1.6.0",
    "express": "catalog:",
    "express-rate-limit": "catalog:",
    "fontkit": "catalog:",
    "helmet": "catalog:",
    "nodemailer": "catalog:",
    "openid-client": "catalog:",
    "pg": "catalog:",
    "pino": "catalog:",
    "pino-http": "catalog:",
    "sharp": "catalog:",
    "socket.io": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nilzora/api-client": "workspace:*",
    "@nilzora/eslint-config": "workspace:*",
    "@nilzora/typescript-config": "workspace:*",
    "@types/busboy": "1.5.4",
    "@types/express": "catalog:",
    "@types/fontkit": "catalog:",
    "@types/node": "catalog:",
    "@types/nodemailer": "catalog:",
    "@types/pg": "catalog:",
    "@types/supertest": "catalog:",
    "eslint": "catalog:",
    "pino-pretty": "catalog:",
    "supertest": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "socket.io-client": "catalog:"
  }
}
