# Nilzora API — local environment template.
# Copy to apps/api/.env (git-ignored) and adjust. Never commit real secrets.
# Only the Supabase settings are required locally; startup fails fast with a clear
# message (naming the variable, never its value) when something is missing or invalid.

# development | test | production. Defaults to development.
NODE_ENV=development

# HTTP port for the API server. Defaults to 4000.
PORT=4000

# fatal | error | warn | info | debug | trace | silent.
# Defaults: debug (development), silent (test), info (production).
# LOG_LEVEL=debug

# Comma-separated browser origins allowed by CORS, as bare origins (no path or slash).
# Defaults to the local storefront and admin in development and test.
# REQUIRED in production, and every production origin must use https.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Number of trusted reverse-proxy hops in front of the API. 0 (default) ignores
# X-Forwarded-For entirely; set it only when the API really runs behind that many proxies.
# TRUST_PROXY_HOPS=0

# Per-IP rate limit (in-memory, per process). Defaults: 300 requests per 60000 ms.
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=300

# Stricter per-IP limit for register, email confirmation, login and refresh.
# Defaults: 20 per 900000 ms.
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX=20

# Stricter per-IP limit for placing and cancelling orders. Defaults: 30 per 600000 ms.
# ORDER_RATE_LIMIT_WINDOW_MS=600000
# ORDER_RATE_LIMIT_MAX=30

# Per-IP limit for admin and moderator changes (product, stock, order, account,
# permission and settings changes, invitations). Defaults: 120 per 60000 ms.
# ADMIN_RATE_LIMIT_WINDOW_MS=60000
# ADMIN_RATE_LIMIT_MAX=120

# Per-IP limit for sending chat messages. Defaults: 60 per 60000 ms. The database also
# caps each sender (30 messages a minute), so this is the outer bound only.
# CHAT_RATE_LIMIT_WINDOW_MS=60000
# CHAT_RATE_LIMIT_MAX=60

# The background worker that drains scheduled chat automation jobs (for example a reminder
# a rule asked for in an hour). Off unless it is switched on, because it needs the direct
# database connection and the service_role grant.
# CHAT_AUTOMATION_WORKER=false
# CHAT_AUTOMATION_WORKER_INTERVAL_MS=30000
# CHAT_AUTOMATION_WORKER_BATCH_SIZE=20

# The background worker that sends customer order emails (order received, out for delivery,
# return and refund updates) queued in the database's email_outbox. Off unless switched on,
# so a development API never emails a customer by accident. It also needs DATABASE_URL and the
# SMTP settings below; on a database without migration 20261227090000 it logs once and idles.
# ORDER_EMAIL_WORKER=false
# ORDER_EMAIL_WORKER_INTERVAL_MS=15000

# Origin of the admin workspace (bare origin, no path). Staff invitation emails link to
# its /accept-invite page, which must also be in Supabase Auth's redirect allow-list.
# Defaults to http://localhost:3001 in development and test; REQUIRED (https) in production.
# ADMIN_APP_ORIGIN=http://localhost:3001

# Shared secret of the Nilzora web servers (storefront and admin): it must equal their
# API_CLIENT_SECRET. Requests carrying it may name the browser address used for rate
# limits; without it every web visitor shares the web server's limit. At least 32
# random characters, different from the Supabase keys, server-only (never a
# NEXT_PUBLIC_/EXPO_PUBLIC_ variable). Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# Optional locally; REQUIRED in production.
# API_CLIENT_SECRET=

# Older name for the same secret, still read when API_CLIENT_SECRET is unset (blank counts
# as unset), so an existing deployment keeps working. When both are set, API_CLIENT_SECRET
# wins and this one is ignored.
# TRUSTED_CLIENT_SECRET=

# Direct PostgreSQL connection for queries that must run as a signed-in account.
# Server-only and never logged. Hosted databases need an encrypted connection:
#   postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?sslmode=require
# For the local stack: postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Optional: while it is unset, identity queries keep using the Supabase Data API.
# DATABASE_URL=

# Redis for the optional public catalog cache (the category tree and the brand list).
# Server-only and never logged; only the host, port and TLS flag are ever reported.
# Accepted forms: redis://host:6379/0 (plain) or rediss://user:password@host:6379 (TLS,
# as Upstash shows it). Query strings are refused so a password cannot leak into a log.
# Optional and safe to leave empty: with it unset the API reads those two collections
# straight from the database on every request, exactly as it did before the cache existed.
# REDIS_URL=

# Supabase — REQUIRED. For the local stack (`pnpm db:start`), copy the API URL and the
# Publishable and Secret keys printed by `pnpm db:status`. Production must use https.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
# Server-only: bypasses row-level security. Never put it in a client app or a
# NEXT_PUBLIC_/EXPO_PUBLIC_ variable.
SUPABASE_SECRET_KEY=

# Cloudflare R2 media storage (product images, category and brand pictures, banners, the
# media library, avatars, review photos, store profile and chat attachments). Server-only
# credentials. All five must be set to switch media uploads on; with none set uploads answer
# 503, and a partial or malformed set fails the start in production.
#
# R2_ACCOUNT_ID is the Cloudflare account id on its own: 32 hexadecimal characters, copied
# from the dashboard URL or the R2 API token page. It is never a URL and never the bucket
# host — the S3 endpoint (https://<account id>.r2.cloudflarestorage.com) is derived from it.
# R2_BUCKET is the bucket name only. R2_PUBLIC_BASE_URL is the https origin that serves reads
# from that bucket (an r2.dev subdomain or a custom domain) and is never the S3 endpoint,
# which requires signed requests. It is not a secret.
# R2_ACCOUNT_ID=replace-me
# R2_ACCESS_KEY_ID=replace-me
# R2_SECRET_ACCESS_KEY=replace-me
# R2_BUCKET=nilzora
# R2_PUBLIC_BASE_URL=https://media.example.com

# Firebase Cloud Messaging service account (order-update push notifications). Server-only.
# Either point at the Firebase Admin SDK JSON, which is the easiest to rotate, or paste the
# three values it contains. FCM_SERVICE_ACCOUNT_FILE wins when both are configured.
# FCM_SERVICE_ACCOUNT_FILE=C:/path/to/nilzora-firebase-adminsdk.json
# All three must be set to switch push delivery on; with none set no notification is sent.
# FCM_PRIVATE_KEY is the "private_key" of the service-account JSON (literal backslash-n escapes are accepted).
# FCM_PROJECT_ID=replace-me
# FCM_CLIENT_EMAIL=replace-me
# FCM_PRIVATE_KEY="replace-me"

# First-party authentication. Off unless OTP_HASH_SECRET is set (at least 32 characters);
# while it is unset the API keeps using Supabase Auth, so nothing breaks.
# The pepper must stay stable: changing it invalidates every code already emailed.
# OTP_HASH_SECRET=replace-with-32-plus-random-characters
# SESSION_ACCESS_TTL_SECONDS=900
# SESSION_REFRESH_TTL_SECONDS=2592000

# Two-factor authentication for super_admin accounts (TOTP authenticator apps). Encrypts the
# TOTP secrets at rest with AES-256-GCM: exactly 32 bytes, as base64 or hex. Server-only.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# REQUIRED in production (the API refuses to start without it). In development, unset means
# 2FA is off (with a warning). Keep it stable and backed up: changing it makes every enrolled
# authenticator unusable, and the owner must then be reset with `pnpm reset-two-factor`.
# TWO_FACTOR_ENCRYPTION_KEY=replace-with-32-random-bytes-base64

# Signs the two-minute ticket the web apps use to open a chat socket, because their access
# tokens live in HttpOnly cookies a browser cannot read. At least 32 characters.
# Unset: a separate key is derived from OTP_HASH_SECRET, and without that key realtime stays
# off (chat still works over REST). The mobile app never needs a ticket: it connects with the
# account's access token.
# CHAT_SOCKET_SECRET=replace-with-32-plus-random-characters

# Local email delivery: the Supabase stack's Inbucket accepts unauthenticated SMTP on
# 54325 (published in supabase/config.toml). Read the messages at http://127.0.0.1:54324.
# With SMTP_HOST or EMAIL_FROM unset, code-dependent routes answer 503 email_unavailable.
# SMTP_HOST=127.0.0.1
# SMTP_PORT=54325
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=no-reply@nilzora.local
#
# A real provider (Gmail, a transactional service) needs authenticated SMTP:
#   * SMTP_USER must be the full account address the provider authenticates, e.g.
#     "name@gmail.com" — not a display name, a store name or a partial address. Gmail answers
#     "535-5.7.8 Username and Password not accepted" for anything else.
#   * SMTP_PASSWORD is an app-specific password, not the account's normal sign-in password.
#     Gmail requires 2-Step Verification and then an App Password (16 letters), and it revokes
#     one the moment the account password changes.
#   * EMAIL_FROM must be that same address (or an alias the account has verified), otherwise the
#     provider rewrites or refuses the sender. It is sent in the "from" line as given, so
#     "Nilzora <name@gmail.com>" is accepted.
#   * Port 587 with SMTP_SECURE=false upgrades to TLS with STARTTLS; use 465 with SMTP_SECURE=true
#     for implicit TLS. Wrong credentials fail at startup: the API logs the SMTP reply code
#     (535, or a connection error) instead of leaving it to be discovered during sign-up.
#
# Optional branding for the account emails (codes, welcome, password changed). Both are
# public addresses, never secrets. Unset, the wordmark is set in text and no button links
# are rendered — nothing is guessed.
#   EMAIL_LOGO_URL  absolute https URL of the official logo image (e.g. the storefront's
#                   /brand/nilzora-logo-on-light.png once it is publicly hosted)
#   EMAIL_SITE_URL  the storefront's public origin, used for "Start shopping" / "Sign in"
# EMAIL_LOGO_URL=
# EMAIL_SITE_URL=

# Google sign-in. Left unset on purpose: the routes answer 503 oauth_unavailable until
# real credentials exist. Never commit them. Create a "Web application" client in Google
# Cloud and register GOOGLE_REDIRECT_URI below, character for character, as an Authorized
# redirect URI (localhost and 127.0.0.1 count as different hosts).
#
# GOOGLE_REDIRECT_URI must be the callback of the app that stores the session cookies:
#   storefront  http://localhost:3000/auth/google/callback   (recommended, full browser flow)
#   no web app  http://localhost:4000/api/v1/auth/google/callback  (API answers JSON only)
# A web app's own callback route relays the code and state to POST /api/v1/auth/google/callback,
# so the client secret never leaves this API.
# GOOGLE_CLIENT_ID=replace-me
# GOOGLE_CLIENT_SECRET=replace-me
# GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Couriers (Steadfast and Pathao). Server-only; nothing here is ever sent to a browser or app.
# The operating switches (mode off/mock/live, real bookings, tracking sync and its interval,
# the request timeout) are NOT environment variables: they are managed in the admin
# workspace (Operations -> Courier settings) and stored in the database. Test (mock) mode
# is refused unless the API's database is local and NODE_ENV is not production.
# Credentials are stored encrypted from the admin workspace; the variables below are only
# per-field fallbacks. Both real adapters are blocked until each courier's merchant API
# documentation is verified, so nothing is booked through a real courier API today.
# Signs mock webhooks (HMAC-SHA256 over "<timestamp>.<raw body>"), at least 32 characters.
# Needed only to test POST /api/v1/webhooks/couriers/<provider> with the mock.
# COURIER_MOCK_WEBHOOK_SECRET=
# Steadfast. The base URL must be https on portal.packzy.com (host taken from unverified
# sources: confirm it against the merchant documentation). Unused while the adapter is blocked.
# STEADFAST_API_BASE_URL=
# STEADFAST_API_KEY=
# STEADFAST_SECRET_KEY=
# STEADFAST_WEBHOOK_TOKEN=
# Pathao. The base URL must be https on api-hermes.pathao.com or
# courier-api-sandbox.pathao.com (unverified hosts: confirm them against the merchant
# documentation). Unused while the adapter is blocked.
# PATHAO_API_BASE_URL=
# PATHAO_CLIENT_ID=
# PATHAO_CLIENT_SECRET=
# PATHAO_USERNAME=
# PATHAO_PASSWORD=
# PATHAO_WEBHOOK_SECRET=
