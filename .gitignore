# Dependencies
node_modules/
.pnpm-store/
pnpm-store/

# Build output
dist/
build/
out/
.next/
.expo/
web-build/
*.tsbuildinfo
next-env.d.ts
expo-env.d.ts

# Device-test and store artifacts kept for local testing (never source)
build-output/
*.apk
*.aab

# Native projects generated by Expo prebuild (continuous native generation)
apps/mobile/android/
apps/mobile/ios/

# Toolchain state inside native source folders. The app's own android/ is generated above; the
# local Expo module (modules/*/android) is source, so only its build state is excluded.
**/android/.gradle/
**/android/.cxx/
**/android/.kotlin/
**/android/local.properties

# Test output
coverage/
playwright-report/
test-results/
blob-report/
playwright/.cache/

# Environment files and secrets (only .env.example files are committed)
.env
.env.*
!.env.example
*.pem
*.key
*.p8
*.p12
*.jks
*.keystore
*.mobileprovision
google-services.json
GoogleService-Info.plist
*service-account*.json
firebase-adminsdk*.json

# Supabase local state
supabase/.branches/
supabase/.temp/

# Database backups (dumps can contain account data and password hashes)
.backups/

# Firebase service-account credentials (private keys; never commit them)
*firebase-adminsdk*.json
*-service-account*.json
service-account*.json
secrets/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Tool caches
.turbo/
.eslintcache
.cache/
.vercel/
.metro-health-check*

# OS and editor files
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
